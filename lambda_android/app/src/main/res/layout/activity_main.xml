<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="0dp">

    <!-- ===== TELA DE CONEXÃO ===== -->
    <LinearLayout
        android:id="@+id/layout_connect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lambda Monitor"
            android:textColor="#EEEEEE"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OBD2 USB → ELM327"
            android:textColor="#888888"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:text="CONECTAR"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#2196F3"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/tv_conn_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conecte o adaptador ELM327 USB"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- ===== DASHBOARD ===== -->
    <RelativeLayout
        android:id="@+id/layout_dash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Barra inferior mínima: Hz + disconnect -->
        <LinearLayout
            android:id="@+id/layout_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/btn_disconnect"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:text="✕"
                android:textSize="36sp"
                android:textColor="#FF5252"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:padding="0dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_battery_voltage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#55FFFFFF"
                android:textSize="56sp"/>

            <TextView
                android:id="@+id/tv_sample_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- Hz"
                android:textColor="#55FFFFFF"
                android:textSize="12sp"
                android:layout_marginLeft="12dp"/>

            <Button
                android:id="@+id/btn_toggle_screen"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:text="⚙"
                android:textSize="28sp"
                android:textColor="#55FFFFFF"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                android:padding="0dp"
                android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <!-- Gráfico ocupa todo o espaço acima da barra inferior -->
        <com.obd2.lambda.LambdaChartView
            android:id="@+id/chart_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layout_bottom_bar"/>

        <!-- Dashboard ocupa o mesmo espaço, começa invisível -->
        <com.obd2.lambda.DashboardView
            android:id="@+id/dashboard_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/layout_bottom_bar"
            android:visibility="gone"/>

    </RelativeLayout>

</LinearLayout>
